{
	"name": "sports-life-game",
	"description": "A BitLife-style American football career simulator",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:lint": "tsc --noEmit -p tsconfig.lint.json",
		"format:check": "prettier --check .",
		"format:write": "prettier --write .",
		"lint": "eslint .",
		"test:node": "NODE_OPTIONS=--disable-warning=DEP0205 node --import tsx --import ./tests/fixtures/csv_loader.mjs --test 'tests/test_*.ts'",
		"test:playwright": "node tests/playwright/autoplay.mjs",
		"build": "./build_github_pages.sh",
		"serve": "./run_web_server.sh",
		"check": "./check_codebase.sh",
		"dev": "esbuild src/main.ts --bundle --format=esm --target=es2020 --sourcemap --loader:.csv=text --loader:.json=json --outfile=dist/main.js --watch"
	},
	"devDependencies": {
		"@playwright/test": ">=1.60.0",
		"@types/node": ">=25.9.1",
		"esbuild": ">=0.28.0",
		"eslint": ">=10.4.0",
		"playwright": ">=1.60.0",
		"prettier": ">=3.8.3",
		"tsx": ">=4.22.3",
		"typescript": ">=6.0.3",
		"typescript-eslint": ">=8.59.4"
	},
	"license": "GPL-3.0",
	"version": "1.0.0",
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vosslab/sports-life-game.git"
	},
	"keywords": [],
	"author": "",
	"bugs": {
		"url": "https://github.com/vosslab/sports-life-game/issues"
	},
	"homepage": "https://github.com/vosslab/sports-life-game#readme"
}
